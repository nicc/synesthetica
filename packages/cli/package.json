{
  "name": "synesthetica",
  "version": "1.0.0",
  "description": "Real-time music visualiser + MCP server. Listens to MIDI or audio, draws it in a Western-music-theory visual language, and exposes the whole thing to Claude Desktop for natural-language control.",
  "license": "BUSL-1.1",
  "author": "Nic Young",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicc/synesthetica.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nicc/synesthetica#readme",
  "bugs": "https://github.com/nicc/synesthetica/issues",
  "keywords": [
    "synesthetica",
    "mcp",
    "mcp-server",
    "claude",
    "music-visualisation",
    "cli"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "synesthetica": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json && npm run bundle-cli && npm run bundle-webapp",
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "bundle-webapp": "node scripts/bundle-webapp.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "cp ../../LICENSE ./LICENSE",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@synesthetica/contracts": "^0.1.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
