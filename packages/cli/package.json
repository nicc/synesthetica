{
  "name": "@synesthetica/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Synesthetica CLI wrapper: launches engine instances and hosts the MCP server (SPEC 013)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "synesthetica": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/prompts && cp src/prompts/*.md dist/prompts/",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@synesthetica/contracts": "*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
