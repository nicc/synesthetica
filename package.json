{
  "name": "synesthetica",
  "private": true,
  "version": "0.0.0",
  "description": "Synesthetica monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @synesthetica/contracts -w @synesthetica/adapters -w @synesthetica/engine -w @synesthetica/web-app -w @synesthetica/cli",
    "clean": "npm run clean --if-present -ws",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "dev": "npm run build -w @synesthetica/contracts -w @synesthetica/adapters -w @synesthetica/engine && npm run dev:chrome -w @synesthetica/web-app",
    "start": "node packages/cli/dist/bin.js start --chrome",
    "start:standalone": "node packages/cli/dist/bin.js start --no-mcp --chrome",
    "smoke:regen": "node --experimental-strip-types docs/smoke-test/generate-manifest.mjs"
  },
  "devDependencies": {
    "@types/webmidi": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  }
}
